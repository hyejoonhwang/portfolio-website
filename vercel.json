{
  "redirects": [
    {
      "source": "/work.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/work",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=31536000, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/thumbnails/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=31536000, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/recently-played.py": {
      "excludeFiles": "{Weave/**,images/**,thumbnails/**,summerlaptop/**,talkspace/**,beebud/**,controlmylaptop/**,library-on-wheels/**,gutsy/**,fonts/**,*.html,*.css,*.js,*.jpeg,*.jpg,*.png,*.pdf,*.md,*.mp4,*.mov}"
    }
  }
}
